  "TemplateID": 1593387,
  "Name": "Duck Savage (Rank 21)",
  "ShadowPips": 2,
  "Cheats": [
    { "When": "EnemyJoins", "Round": 1,
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00001863"},
        {"Do": "Cast", "Spell": "Stun", "SpellID": 2514611, "Target": "Caster", "DispelImmune": false}
