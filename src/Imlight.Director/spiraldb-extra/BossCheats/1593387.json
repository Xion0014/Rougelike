      ],
      "Notes": "Round 1: Frozen Armor (5,000 absorb)." },

    { "When": "PlayerCasts", "Spells": ["Steal Ward"], "OnBoss": true,
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00001866"},
        {"Do": "Cast", "Spell": "Steal Ward", "SpellID": 531030646, "Target": "Caster", "DispelImmune": false}
      ],
      "Notes": "Steal Ward on her: she steals them back." },

    { "When": "RoundStart", "HasWho": "AnyAlly", "HasKind": "HoT", "Chance": 50,
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00001868"},
        {"Do": "Cast", "Spell": "Duck Savage", "SpellID": 507214697, "Target": "Matched", "DispelImmune": false}
      ],
      "Notes": "An ally with a HoT: it lasts a round more." },

    { "When": "RoundStart", "HasWho": "AnyAlly", "HasKind": "DoT",
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00001867"},
        {"Do": "Cast", "Spell": "Cooldown", "SpellID": 1498819280, "Target": "Matched", "DispelImmune": false}
      ],
      "Notes": "An ally with a DoT: Cooldown takes it off." },

    { "When": "RoundStart", "FromRound": 2, "HasWho": "Self", "HasKind": "Aura,Ward", "HasNot": true,
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00001865"},
        {"Do": "Cast", "Spell": "Fortify", "SpellID": 1058059056, "Target": "Self", "DispelImmune": false}
