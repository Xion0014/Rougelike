      ],
      "Notes": "Round 1 and every 3 rounds: Hisamoto casts Legion Shield, free. New block: an ally casts." },

    { "When": "PlayerCasts", "Category": "Damage", "OnBoss": true, "CostMin": 6, "AlliesUp": ["589301"],
