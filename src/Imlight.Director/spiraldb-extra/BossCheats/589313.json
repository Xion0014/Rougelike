        {"Do": "Say", "Line": "WizardBossFights_00000161"},
        {"Do": "Cast", "Spell": "Smoke Screen", "SpellID": 583267359, "Target": "Caster", "DispelImmune": false},
        {"Do": "CastBy", "By": "Creature", "Spell": "Unicorn", "SpellID": 1606885698, "Target": "", "DispelImmune": false, "Creature": 589301}
      ],
      "Notes": "\"Chain Reaction!\" A 6+ pip damage spell on him while Hisamoto stands: Smoke Screen, then Hisamoto's Unicorn. New blocks: these allies, an ally casts. \"A {pips} pip\" is read as {pips} or more (a guess)." },

    { "When": "PlayerCasts", "Category": "Damage", "OnBoss": true, "CostMin": 6, "AlliesUp": ["589305"], "AlliesDown": ["589301"],
      "Actions": [
        {"Do": "Say", "Line": "WizardBossFights_00000163"},
        {"Do": "Cast", "Spell": "Blizzard", "SpellID": 827011788, "Target": "", "DispelImmune": false},
        {"Do": "CastBy", "By": "Creature", "Spell": "Minor Blessing", "SpellID": 47681859, "Target": "AllAllies", "DispelImmune": false, "Creature": 589305}
