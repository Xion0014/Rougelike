      ],
      "Notes": "A wizard's global while active: Balefrost." },

    { "When": "RoundStart", "HasWho": "Self", "HasSpell": "Feint",
      "Actions": [
        {"Do": "RemoveWards", "Kind": "Good", "Spell": "Feint", "Target": "Self"}
      ],
      "Notes": "A Feint on it at the start of a round comes off." }
  ]
