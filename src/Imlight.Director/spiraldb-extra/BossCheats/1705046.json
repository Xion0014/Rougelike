        {"Do": "Cast", "Spell": "Balefrost", "SpellID": 297040356, "Target": "", "DispelImmune": false}
      ],
      "Notes": "The Death/Fire head falls: it becomes active." },

    { "When": "RoundEnd", "AlliesDown": ["1705043", "1705044", "1705045"],
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00004104"},
        {"Do": "Pips", "Amount": 2, "Kind": "Power"},
        {"Do": "Pips", "Amount": 1, "Kind": "Normal"}
      ],
      "Notes": "End of each round while active: two power pips and a pip." },

    { "When": "PlayerGlobals", "AlliesDown": ["1705043", "1705044", "1705045"],
