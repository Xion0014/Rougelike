      "Actions": [
        {"Do": "Cast", "Spell": "Donate Power", "SpellID": 598358693, "Target": "", "DispelImmune": false}
      ],
      "Notes": "3 wizards: 2 power pips." },

    { "When": "RoundEnd", "PlayersMin": 4,
      "Actions": [
        {"Do": "Cast", "Spell": "Donate Power", "SpellID": 732576421, "Target": "", "DispelImmune": false}
