      "Notes": "Hurt: marked for this round." },

    { "When": "RoundStart", "FromRound": 2, "Mark": "hurt this round", "MarkWho": "Self", "NotMarked": true,
      "Actions": [
        {"Do": "Say", "Line": "WizardBossFights_00000113"},
        {"Do": "Cast", "Spell": "Ra", "SpellID": 389025122, "Target": "", "DispelImmune": false}
      ],
      "Notes": "A round he was not hurt: Ra at the start of the next." },

    { "When": "RoundStart",
      "Actions": [
        {"Do": "Unmark", "Mark": "hurt this round", "Target": "Self"}
      ],
      "Notes": "Then the mark comes off for the new round." },

    { "When": "RoundStart", "Chance": 50, "HasWho": "Self", "HasKind": "DoT",
      "Actions": [
        {"Do": "Say", "Line": "WizardBossFights_00000171"},
        {"Do": "CastBy", "By": "Creature", "Spell": "Triage", "SpellID": 1907249548, "Target": "Owner", "DispelImmune": false, "Creature": 684256}
      ],
      "Notes": "A DoT on him: sometimes (50%, a guess) Grim Calaca casts Triage on him. New block: target Owner." }
  ]
