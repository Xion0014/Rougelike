  "TemplateID": 1340305,
  "Name": "Rattlebones (Rank 7)",
  "Cheats": [
    { "When": "Passive", "Passive": "Minions", "Brings": ["1340306"],
      "Notes": "He fights with the Fairy Queen (Wizard404: his minion, 2026-10-24). A battle started against him brings her in: the room's own Queen first, else she is summoned. New block: comes with." },

    { "When": "EnemyJoins", "Round": 1,
      "Casts": [ { "Spell": "Mana Burn", "DispelImmune": false } ], "Target": "Caster",
      "Line": "CombatMessages_00000676",
      "Notes": "\"Tardiness will not be tolerated!\" A wizard who joins after the battle has begun gets Mana Burn, the one in his deck (Balance: Unbalance stops it)." },

    { "When": "PlayerHeals",
      "Casts": [ { "Spell": "Doom and Gloom - Nosferabbit", "DispelImmune": false } ],
      "Line": "CombatMessages_00000675",
      "Notes": "\"Let's dampen the Heals!\" A wizard's heal (a pet's too) gets a -75% Doom and Gloom, as in his deck (Death: Strangle stops it)." },

    { "When": "PlayerCasts", "Spells": ["Feint"], "AnyVersion": true, "School": "Death", "OnBoss": true,
      "Casts": [ { "Spell": "Swap Negative Wards-Rattlebones", "DispelImmune": false } ], "Target": "Caster",
      "Line": "CombatMessages_00000674",
      "Notes": "\"Why don't we trade?\" A Feint put on him: the traps swap so the bigger one is on that wizard (Melt stops it)." }
  ]
