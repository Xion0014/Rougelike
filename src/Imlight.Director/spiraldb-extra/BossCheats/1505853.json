{
  // Heidi (Rank 19, Fire, 10,240 health), Karamelle. Heidi: Fuel and Quench for a late wizard, a Fire Elemental every 3rd round, Balanceblade for DoTs, and growing Berserks.
  // From Wizard404's data (fetched 2026-10-24; its cheat notes are wiki-written, so they guide, not prove; ones it marks as needing verification are made as if confirmed).
  // Built first from blocks that were there, then from new universal blocks where a Notes names one (Niduus,
  // 2026-10-23: "ALL CHEATS are to be compatible for PLAYERS and CREATURES"). Lines are the game's own, by key.
  // Checked against its Wizard101 Central page (saved 2026-10-24): a Balanceblade for each DoT on the wizard, not one in all.
  "TemplateID": 1505853,
  "Name": "Heidi (Rank 19)",
  "ShadowPips": 1,
  "Cheats": [
    { "When": "EnemyJoins", "Round": 2,
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00001575"},
        {"Do": "Cast", "Spell": "Fuel", "SpellID": 2563718, "Target": "Caster", "DispelImmune": false},
        {"Do": "Cast", "Spell": "Quench", "SpellID": 1810489711, "Target": "Caster", "DispelImmune": false}
      ],
      "Notes": "A wizard joins after round 2: Fuel, Quench on them." },

    { "When": "RoundStart", "Round": 1, "Every": 3, "AlliesDown": ["1515500"],
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00001577"},
        {"Do": "Cast", "Spell": "Fire Elemental", "SpellID": 1694538556, "Target": "", "DispelImmune": false}
      ],
      "Notes": "Round 1 and every 3rd, with no Fire Elemental: one comes." },

    { "When": "PlayerCasts", "HasWho": "Caster", "HasKind": "DoT", "Fizzle": "Any",
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00001576"},
        {"Do": "Cast", "Spell": "Balanceblade", "SpellID": 514206205, "Target": "Caster", "DispelImmune": false}
      ],
      "Notes": "A wizard with a DoT takes their turn: Balanceblade on them. One more for each further DoT (cheats below)." },

    { "When": "PlayerCasts", "HasWho": "Caster", "HasKind": "DoT", "HasCount": 2, "Fizzle": "Any",
      "Actions": [
        {"Do": "Cast", "Spell": "Balanceblade", "SpellID": 514206205, "Target": "Caster", "DispelImmune": false}
      ],
      "Notes": "A wizard with 2 or more DoTs: another Balanceblade (Central: one for each DoT)." },

    { "When": "PlayerCasts", "HasWho": "Caster", "HasKind": "DoT", "HasCount": 3, "Fizzle": "Any",
      "Actions": [
        {"Do": "Cast", "Spell": "Balanceblade", "SpellID": 514206205, "Target": "Caster", "DispelImmune": false}
      ],
      "Notes": "A wizard with 3 or more DoTs: another Balanceblade (Central: one for each DoT)." },

    { "When": "PlayerCasts", "HasWho": "Caster", "HasKind": "DoT", "HasCount": 4, "Fizzle": "Any",
      "Actions": [
        {"Do": "Cast", "Spell": "Balanceblade", "SpellID": 514206205, "Target": "Caster", "DispelImmune": false}
      ],
      "Notes": "A wizard with 4 or more DoTs: another Balanceblade (Central: one for each DoT)." },

    { "When": "MinionDefeated", "Creature": 1515500, "MaxTimes": 5,
      "Actions": [
        {"Do": "InTurn", "Count": 5, "Group": 2},
        {"Do": "Say", "Line": "CombatMessages_00001578"},
        {"Do": "Cast", "Spell": "Berserk", "SpellID": 1149404688, "Target": "Self", "DispelImmune": false},
        {"Do": "Say", "Line": "CombatMessages_00001579"},
        {"Do": "Cast", "Spell": "Berserk", "SpellID": 1149416976, "Target": "Self", "DispelImmune": false},
        {"Do": "Say", "Line": "CombatMessages_00001580"},
        {"Do": "Cast", "Spell": "Berserk", "SpellID": 1149412880, "Target": "Self", "DispelImmune": false},
        {"Do": "Say", "Line": "CombatMessages_00001580"},
        {"Do": "Cast", "Spell": "Berserk", "SpellID": 1149425168, "Target": "Self", "DispelImmune": false},
        {"Do": "Say", "Line": "CombatMessages_00001580"},
        {"Do": "Cast", "Spell": "Berserk", "SpellID": 1182965264, "Target": "Self", "DispelImmune": false}
