  // John Seward (Rank 25, Life, 20,545 health), Darkmoor. John Seward: a Werewolf who heals when hit until he unpolymorphs at the end of round 6.
  // From Wizard404's data (fetched 2026-10-24; its cheat notes are wiki-written, so they guide, not prove; ones it marks as needing verification are made as if confirmed).
  // Built first from blocks that were there, then from new universal blocks where a Notes names one (Niduus,
  // 2026-10-23: "ALL CHEATS are to be compatible for PLAYERS and CREATURES"). Lines are the game's own, by key.
  "TemplateID": 1705026,
  "Name": "John Seward (Rank 25)",
  "Cheats": [
    { "When": "BattleStart",
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00003933"},
        {"Do": "Polymorph", "Spell": "Polymorph", "SpellID": 313752024, "Target": "Self"}
      ],
      "Notes": "Round 1: he becomes the Werewolf." },

    { "When": "BossHit", "ToRound": 6,
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00003935"},
        {"Do": "Cast", "Spell": "Heal", "SpellID": 823904294, "Target": "Self", "DispelImmune": false}
      ],
      "Notes": "A damage spell on him while a Werewolf: Heal 780." },

    { "When": "RoundEnd", "Round": 6,
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00003934"},
        {"Do": "Polymorph", "Spell": "Unpolymorph", "SpellID": 1965093060, "Target": "Self"}
      ],
      "Notes": "End of round 6: he turns back." },

    { "When": "RoundStart", "Round": 11, "Every": 10,
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00003933"},
        {"Do": "Polymorph", "Spell": "Polymorph", "SpellID": 313752024, "Target": "Self"}
      ],
      "Notes": "The 5th round after: the Werewolf again." }
  ]
}
