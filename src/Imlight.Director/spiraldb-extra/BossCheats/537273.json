{
  // Elephant Spectral Guardian (Rank 11, Sun, 7,390 health), Zafaria. Elephant Spectral Guardian: Tower Shield, a Stun Block mark needing a charm, the Guardians' spells, and Scarecrow once alone.
  // From Wizard404's data (fetched 2026-10-24; its cheat notes are wiki-written, so they guide, not prove; ones it marks as needing verification are made as if confirmed).
  // Built first from blocks that were there, then from new universal blocks where a Notes names one (Niduus,
  // 2026-10-23: "ALL CHEATS are to be compatible for PLAYERS and CREATURES"). Lines are the game's own, by key.
  "TemplateID": 537273,
  "Name": "Elephant Spectral Guardian (Rank 11)",
  "Cheats": [
    { "When": "BattleStart",
      "Actions": [
        {"Do": "Cast", "Spell": "Tower Shield", "SpellID": 2013941342, "Target": "Self", "DispelImmune": false}
      ],
      "Notes": "Round 1: Tower Shield." },

    { "When": "RoundStart", "Round": 3, "Every": 3,
      "Actions": [
        {"Do": "Say", "Line": "WizardBossFights_00000130"},
        {"Do": "Cast", "Spell": "Stun Block", "SpellID": 1118793144, "Target": "Enemy", "DispelImmune": false},
        {"Do": "Mark", "Mark": "marked", "Target": "Last"}
      ],
      "Notes": "Every 3 rounds: a Stun Block marker on a wizard." },

    { "When": "PlayerCharms", "Mark": "marked", "MarkWho": "Caster",
      "Actions": [
        {"Do": "Unmark", "Mark": "marked", "Target": "Caster"}
      ],
      "Notes": "The marked wizard casts a charm: the chain is off." },

    { "When": "RoundStart", "Round": 4, "Every": 3, "Mark": "marked", "MarkWho": "AnyEnemy",
      "Actions": [
        {"Do": "Say", "Line": "WizardBossFights_00000131"},
        {"Do": "CastBy", "By": "Creature", "Spell": "Smoke Screen", "SpellID": 305778176, "Target": "Marked", "DispelImmune": false, "Creature": 470013},
        {"Do": "CastBy", "By": "Creature", "Spell": "Orthrus", "SpellID": 1203805666, "Target": "", "DispelImmune": false, "Creature": 537152},
        {"Do": "CastBy", "By": "Creature", "Spell": "Blizzard", "SpellID": 793374203, "Target": "", "DispelImmune": false, "Creature": 470014},
        {"Do": "Cast", "Spell": "Cleanse Ward", "SpellID": 2007995204, "Target": "Marked", "DispelImmune": false},
        {"Do": "Unmark", "Mark": "marked", "Target": "AllEnemies"}
      ],
      "Notes": "The next round, if the marked wizard cast no charm: the Gorilla's Smoke Screen, the Lion's Orthrus, the Zebra's Blizzard, then Cleanse Ward on the marker." },

    { "When": "MinionDefeated", "AlliesMax": 0, "Once": true,
      "Actions": [
        {"Do": "Say", "Line": "WizardBossFights_00000132"},
        {"Do": "Cast", "Spell": "Cleanse Ward", "SpellID": 2007994870, "Target": "Self", "DispelImmune": false},
        {"Do": "Mark", "Mark": "alone", "Target": "Self"}
      ],
      "Notes": "No minions left: Cleanse Ward on his Tower Shield." },

    { "When": "RoundStart", "Round": 3, "Every": 3, "Mark": "alone", "MarkWho": "Self",
      "Actions": [
        {"Do": "Say", "Line": "WizardBossFights_00000133"},
        {"Do": "Cast", "Spell": "Scarecrow", "SpellID": 1503349264, "Target": "", "DispelImmune": false}
      ],
      "Notes": "Every 3 rounds once alone: Scarecrow." }
  ]
}
