        {"Do": "Cast", "Spell": "Storm Lord", "SpellID": 1935718089, "Target": "", "DispelImmune": false},
        {"Do": "Cast", "Spell": "Ra", "SpellID": 1643564626, "Target": "", "DispelImmune": false}
