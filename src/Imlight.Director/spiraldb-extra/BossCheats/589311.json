        {"Do": "Say", "Line": "WizardBossFights_00000163"},
        {"Do": "Cast", "Spell": "Storm Lord", "SpellID": 1935718089, "Target": "", "DispelImmune": false},
        {"Do": "CastBy", "By": "Creature", "Spell": "Minor Blessing", "SpellID": 316117315, "Target": "AllAllies", "DispelImmune": false, "Creature": 589303}
