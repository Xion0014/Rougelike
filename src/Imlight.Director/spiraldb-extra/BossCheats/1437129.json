        {"Do": "Cast", "Spell": "Curse-Jabberwock", "SpellID": 966358310, "Target": "Self", "DispelImmune": false}
      ],
      "Notes": "Every 3rd round, 1 wizard(s): Meteor Strike, then a curse on itself." },

