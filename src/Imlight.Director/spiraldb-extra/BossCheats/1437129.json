  "TemplateID": 1437129,
  "Name": "Dream Jabberwock (Rank 16)",
  "ShadowPips": 2,
  "Cheats": [
    { "When": "ICast", "Spells": ["Natural Attack"],
      "Actions": [
        {"Do": "Cast", "Spell": "Black Mantle", "SpellID": 1425661579, "Target": "Receiver", "DispelImmune": false}
      ],
      "Notes": "After its Natural Attack: Black Mantle on the wizard." },

    { "When": "PlayerCasts", "Fizzle": "Fizzled",
      "Actions": [
        {"Do": "Cast", "Spell": "Empower", "SpellID": 1104187399, "Target": "Self", "DispelImmune": false}
      ],
      "Notes": "A wizard fizzles: Empower on itself." },

    { "When": "SideFizzles",
      "Actions": [
        {"Do": "Cast", "Spell": "Empower", "SpellID": 1104187399, "Target": "Self", "DispelImmune": false}
      ],
      "Notes": "It or an ally fizzles: Empower on itself (Central: the opponents' fizzles too, cheat above; Central calls it a Dark Empower of 2 power pips)." },

    { "When": "EnemyJoins", "Round": 1,
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00001000"},
        {"Do": "Cast", "Spell": "Mana Burn", "SpellID": 0, "Target": "Caster", "DispelImmune": false}
      ],
      "Notes": "A late wizard: Mana Burn." },

    { "When": "PlayerCasts", "Spells": ["Feint"], "OnBoss": true,
