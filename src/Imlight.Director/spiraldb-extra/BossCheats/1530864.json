      ],
      "Notes": "A wizard joins after round 1: Camp Bandit on them." },

    { "When": "RoundStart", "HealthAbove": 99,
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00001910"},
        {"Do": "Cast", "Spell": "Leafstorm", "SpellID": 1302841655, "Target": "", "DispelImmune": false},
        {"Do": "Cast", "Spell": "Enfeeble", "Target": "AllEnemies", "DispelImmune": false}
      ],
      "Notes": "Each round at full health: Leafstorm, then Enfeeble." },

    { "When": "RoundStart", "HealthUnder": 100,
      "Actions": [
        {"Do": "Cast", "Spell": "Blessing", "SpellID": 1650901013, "Target": "Self", "DispelImmune": false}
      ],
      "Notes": "Each round not at full: Blessing." },

