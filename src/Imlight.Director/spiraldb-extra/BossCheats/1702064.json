{
  // Broken Branch King (Rank 24, Ice, 17,635 health), Darkmoor. Broken Branch King: marks a wizard KING and traps them every 3 rounds; Meteor Strike when they fall.
  // From Wizard404's data (fetched 2026-10-24; its cheat notes are wiki-written, so they guide, not prove; ones it marks as needing verification are made as if confirmed).
  // Built first from blocks that were there, then from new universal blocks where a Notes names one (Niduus,
  // 2026-10-23: "ALL CHEATS are to be compatible for PLAYERS and CREATURES"). Lines are the game's own, by key.
  // Checked against its Wizard101 Central page (saved 2026-10-24): the +200% trap comes when the marked wizard drops under 10% health.
  "TemplateID": 1702064,
  "Name": "Broken Branch King (Rank 24)",
  "Cheats": [
    { "When": "BattleStart",
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00003906"},
        {"Do": "Say", "Line": "CombatMessages_00003905"},
        {"Do": "Cast", "Spell": "Stun Block", "SpellID": 673362723, "Target": "Enemy", "DispelImmune": false},
        {"Do": "Mark", "Mark": "king", "Target": "Last"}
      ],
      "Notes": "Round 1: a random wizard is marked KING (Stun Block)." },

    { "When": "RoundEnd", "Round": 3, "Every": 3, "Mark": "king", "MarkWho": "AnyEnemy",
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00003909"},
        {"Do": "Cast", "Spell": "Hex", "SpellID": 1087469580, "Target": "Marked", "DispelImmune": false}
      ],
      "Notes": "End of every 3rd round: Hex (+100% trap) on the King wizard." },

    { "When": "PlayerHealthBelow", "Mark": "king", "MarkWho": "Caster", "Percent": 10,
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00003910"},
        {"Do": "Cast", "Spell": "Hex", "SpellID": 2133755892, "Target": "Caster", "DispelImmune": false}
      ],
      "Notes": "The King wizard under 10% health: Hex (+200% trap) (Central)." },

    { "When": "PlayerDefeated", "Mark": "king", "MarkWho": "Receiver",
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00003907"},
        {"Do": "Cast", "Spell": "Meteor Strike", "SpellID": 625314324, "Target": "", "DispelImmune": false}
      ],
      "Notes": "The King wizard falls: Meteor Strike." },

    { "When": "MinionDefeated", "Creature": 1702065,
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00003908"},
        {"Do": "RemoveAuras", "Target": "Self"}
      ],
      "Notes": "The Queen falls: his aura comes off." }
  ]
}
