<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>ImlightSetup</AssemblyName>
    <RootNamespace>Imlight.Setup</RootNamespace>
    <!-- Overridden by the release workflow with the tag, e.g. -p:Version=1.2.0 -->
    <Version>0.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- The app window draws itself (Avalonia, with Skia); its native parts go inside the single exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- dotnet publish -p:ImlightEdition=Manager builds ImlightManager.exe, which installs the Niduus/Imlight fork. -->
  <PropertyGroup Condition="'$(ImlightEdition)' == 'Manager'">
    <AssemblyName>ImlightManager</AssemblyName>
    <DefineConstants>$(DefineConstants);MANAGER_EDITION</DefineConstants>
  </PropertyGroup>

  <!-- dotnet publish -p:ImlightEdition=Roguelike builds SpiralRoguelike.exe, the playful roguelike launcher. -->
  <PropertyGroup Condition="'$(ImlightEdition)' == 'Roguelike'">
    <AssemblyName>SpiralRoguelike</AssemblyName>
    <DefineConstants>$(DefineConstants);MANAGER_EDITION;ROGUELIKE_EDITION</DefineConstants>
    <ApplicationIcon>Assets\launcher.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The launcher window's fonts (see Assets\Fonts\README.txt) and icon. -->
    <AvaloniaResource Include="Assets\**\*.ttf" />
    <AvaloniaResource Include="Assets\launcher.ico" />
    <!-- Also written next to the installed launcher, so the desktop shortcut points at the icon itself. -->
    <EmbeddedResource Include="Assets\launcher.ico" LogicalName="launcher.ico" />
    <!-- The launcher's FAQ and credits pages: edit these text files to change them. -->
    <AvaloniaResource Include="Assets\faq.txt" />
    <AvaloniaResource Include="Assets\credits.txt" />
    <AvaloniaResource Include="Assets\rules.txt" />
    <AvaloniaResource Include="Assets\notice.txt" />
  </ItemGroup>

  <!-- The branch the program installs and updates by default; the release workflow passes -p:ImlightBranch=<branch>. -->
  <ItemGroup Condition="'$(ImlightBranch)' != ''">
    <AssemblyMetadata Include="ImlightBranch" Value="$(ImlightBranch)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <!-- The archive reader, which needs no game data to build. -->
    <ProjectReference Include="..\..\submodule\Imcodec\src\Imcodec.Wad\Imcodec.Wad.csproj" />
    <!-- The data file decoder for the Game Files tab. It is generated from a type dump, so copy
         submodule\Imcodec\test\CodeGen\Inputs\*.json into Imcodec.ObjectProperty\GeneratorInput first
         (the release workflow does). -->
    <ProjectReference Include="..\..\submodule\Imcodec\src\Imcodec.ObjectProperty\Imcodec.ObjectProperty.csproj" />
  </ItemGroup>

</Project>
